{
  "name": "@egret/integrations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "26.7.0"
  },
  "exports": {
    "./archive": {
      "types": "./dist/archive.d.ts",
      "import": "./dist/archive.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.js"
    },
    "./physics": {
      "types": "./dist/physics.d.ts",
      "import": "./dist/physics.js"
    },
    "./texture": {
      "types": "./dist/texture.d.ts",
      "import": "./dist/texture.js"
    },
    "./tiled": {
      "types": "./dist/tiled.d.ts",
      "import": "./dist/tiled.js"
    },
    "./web/audio": {
      "types": "./dist/web/audio.d.ts",
      "import": "./dist/web/audio.js"
    },
    "./web/storage": {
      "types": "./dist/web/storage.d.ts",
      "import": "./dist/web/storage.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "dev": "node tools/example.mjs",
    "verify:browser": "node tools/verify-browser.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "howler": "2.2.4",
    "i18next": "27.1.1",
    "idb-keyval": "6.3.0",
    "ktx-parse": "2.0.0",
    "planck": "1.5.1",
    "sax": "1.1.6",
    "tmx-parser": "1.5.0"
  },
  "devDependencies": {
    "@types/howler": "2.2.13",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "typescript": "7.0.2"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES"
  ]
}
