    "./web": "./legacy-web.mjs",
    "./theme-factories": { "types": "./compat/theme-factories.d.mts", "import": "./compat/theme-factories.mjs" },
    "./android": { "types": "./compat/android.d.mts", "import": "./compat/android.mjs" },
    "./scene": { "types": "./compat/scene.d.mts", "import": "./compat/scene.mjs" }
