{
  "extends": "./tsconfig.dom-free.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "noImplicitOverride": true,
    "noEmitOnError": true,
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "skipLibCheck": false
  },
  "include": ["spritesheet-positive.ts"]
}
