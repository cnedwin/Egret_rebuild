{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "noEmitOnError": true,
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "composite": true
  }
}
