+// SPDX-License-Identifier: Apache-2.0
+// First-party private comparison glue; no upstream algorithm replacement.
+// Skia integration retains its BSD notices; stock SheenBidi retains Apache-2.0.
+#include "modules/skunicode/src/SkUnicode_sheen_private.h"
+#include "src/core/SkUTF.h"
+#include <climits>
+#include <new>
+#include <utility>
+
+namespace SkUnicodes::SheenPrivate {
+namespace {
+bool WellFormed(const std::u16string& text) {
+    for (size_t i=0; i<text.size(); ++i) {
+        const uint16_t u=text[i];
+        if (u>=0xD800 && u<=0xDBFF) {
+            if (++i==text.size() || text[i]<0xDC00 || text[i]>0xDFFF) { return false; }
+        } else if (u>=0xDC00 && u<=0xDFFF) { return false; }
+    }
+    return true;
+}
+bool FromUtf8(const char* text, int count, std::u16string* copied) {
+    if (count<0 || (count && !text)) { return false; }
+    if (!count) { copied->clear(); return true; }
+    const int units=SkUTF::UTF8ToUTF16(nullptr,0,text,count);
+    if (units<0) { return false; }
+    copied->resize(units);
+    return SkUTF::UTF8ToUTF16(reinterpret_cast<uint16_t*>(copied->data()),units,text,count)==units
+           && WellFormed(*copied);
+}
+class OwnedIterator final : public SkBidiIterator {
+public:
+    explicit OwnedIterator(std::vector<uint8_t>&& levels) : fLevels(std::move(levels)) {}
+    Position getLength() override { return static_cast<Position>(fLevels.size()); }
+    Level getLevelAt(Position pos) override {
+        return pos>=0 && static_cast<size_t>(pos)<fLevels.size() ? fLevels[pos] : 0;
+    }
+private:
+    std::vector<uint8_t> fLevels;
+};
+ParagraphMode FixedMode(SkBidiIterator::Direction dir) {
+    return dir==SkBidiIterator::kLTR ? ParagraphMode::kLtr : ParagraphMode::kRtl;
+}
+}  // namespace
+
+Observation Observe(const std::u16string& text, const std::vector<std::string>& classes,
+                    bool classesMode, ParagraphMode mode) {
+    Observation out;
+    std::u16string carriers;
+    std::vector<const char*> names;
+    const std::u16string* input=&text;
+    if (classesMode) {
+        if (classes.size()>256) { out.refusalReason="CLASS_LIMIT"; return out; }
+        carriers.reserve(classes.size()); names.reserve(classes.size());
+        for (size_t i=0; i<classes.size(); ++i) {
+            if (classes[i].find('\0')!=std::string::npos) {
+                out.refusalReason="INVALID_BIDI_CLASS"; return out;
+            }
+            carriers.push_back(static_cast<char16_t>(0xE000+i));
+            names.push_back(classes[i].c_str());
+        }
+        input=&carriers;
+    }
+    if (input->size()>INT32_MAX || !WellFormed(*input)) {
+        out.refusalReason="MALFORMED_UTF16_OR_LENGTH"; return out;
+    }
+    const int32_t n=static_cast<int32_t>(input->size());
+    out.nativeInputLength=n;
+    // Standard containers share the existing Wasm allocation-fatal boundary.
+    // The native library's nullable allocation failures below are ordinary
+    // refusals; no claim is made that JS/C++ allocation exhaustion is recoverable.
+    out.rawParagraphLevels.resize(n); out.levels.resize(n); out.visualToLogical.resize(n);
+    std::vector<int32_t> ends(n);
+    std::vector<uint8_t> paragraphLevels(n);
+    const auto native=EgretSheenObserve(reinterpret_cast<const uint16_t*>(input->c_str()),n,
+        classesMode ? names.data() : nullptr,classesMode ? 1 : 0,static_cast<int32_t>(mode),
+        out.rawParagraphLevels.data(),out.levels.data(),out.visualToLogical.data(),
+        ends.data(),paragraphLevels.data());
+    out.errorCode=native.error;
+    out.nativeParagraphsCreated=native.nativeParagraphsCreated;
+    out.paragraphLevel=native.paragraphLevel;
+    if (native.error) {
+        out.refusalReason=native.error==2 ? "SHEEN_ALLOCATION_FAILED" :
+                          native.error==4 ? "INVALID_BIDI_CLASS" :
+                          native.error==1 ? "INVALID_NATIVE_ARGUMENT" : "SHEEN_OUTPUT_RANGE";
+        out.rawParagraphLevels.clear(); out.levels.clear(); out.visualToLogical.clear();
+        return out;
+    }
+    int32_t start=0;
+    for (int32_t i=0; i<native.paragraphCount; ++i) {
+        out.paragraphs.push_back({start,ends[i],paragraphLevels[i]}); start=ends[i];
+    }
+    out.nativeResultLength=n;
+    out.levelsRead=n>0;
+    return out;
+}
+
+std::unique_ptr<SkBidiIterator> MakeIterator(const uint16_t* text, int count,
+                                          SkBidiIterator::Direction dir) {
+    if (count<0 || (count && !text)) { return nullptr; }
+    const std::u16string copied(count ? reinterpret_cast<const char16_t*>(text) : u"",
+                                static_cast<size_t>(count));
+    auto result=Observe(copied,{},false,FixedMode(dir));
+    if (!result.refusalReason.empty()) { return nullptr; }
+    return std::unique_ptr<SkBidiIterator>(new (std::nothrow) OwnedIterator(std::move(result.levels)));
+}
+std::unique_ptr<SkBidiIterator> MakeIterator(const char* text, int count,
+                                          SkBidiIterator::Direction dir) {
+    std::u16string copied;
+    if (!FromUtf8(text,count,&copied)) { return nullptr; }
+    return MakeIterator(reinterpret_cast<const uint16_t*>(copied.c_str()),
+                        static_cast<int>(copied.size()),dir);
+}
+bool GetBidiRegions(const char* text, int count, SkUnicode::TextDirection dir,
+                   std::vector<SkUnicode::BidiRegion>* results) {
+    if (!results) { return false; }
+    std::u16string copied;
+    if (!FromUtf8(text,count,&copied)) { return false; }
+    auto result=Observe(copied,{},false,dir==SkUnicode::TextDirection::kLTR
+        ? ParagraphMode::kLtr : ParagraphMode::kRtl);
+    if (!result.refusalReason.empty()) { return false; }
+    std::vector<SkUnicode::BidiRegion> complete;
+    std::vector<int32_t> byteAt(copied.size()+1,-1);
+    const char* cursor=text;
+    const char* end=count ? text+count : text;
+    size_t unit=0;
+    byteAt[0]=0;
+    while (cursor!=end) {
+        const SkUnichar cp=SkUTF::NextUTF8(&cursor,end);
+        if (cp<0) { return false; }
+        unit+=cp>0xFFFF ? 2 : 1;
+        if (unit>copied.size()) { return false; }
+        byteAt[unit]=static_cast<int32_t>(cursor-text);
+    }
+    if (unit!=copied.size()) { return false; }
+    size_t start=0;
+    for (size_t i=0; i<copied.size();) {
+        const size_t width=copied[i]>=0xD800 && copied[i]<=0xDBFF ? 2 : 1;
+        const auto level=result.levels[i];
+        if (width==2 && result.levels[i+1]!=level) { return false; }
+        if (i && level!=result.levels[start]) {
+            complete.emplace_back(byteAt[start],byteAt[i],result.levels[start]); start=i;
+        }
+        i+=width;
+    }
+    if (!copied.empty()) { complete.emplace_back(byteAt[start],count,result.levels[start]); }
+    // Failure above preserves the caller's old result. No failed iterator is
+    // passed to SkUnicode::forEachBidiRegion (which assumes non-null).
+    results->swap(complete);
+    return true;
+}
+}  // namespace SkUnicodes::SheenPrivate
