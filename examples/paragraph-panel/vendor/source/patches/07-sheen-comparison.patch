+// SPDX-License-Identifier: Apache-2.0
+// First-party private C shim. Included stock vendor remains unmodified Apache-2.0.
+// Skia integration retains its original BSD notices.
+// UNITY keeps SB_INTERNAL static: the typed seam is called in this same TU.
+#include "SkUnicode_sheen_private.h"
+#include "../../../third_party/externals/sheenbidi/Source/SheenBidi.c"
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int EgretSheenClass(const char* name, SBBidiType* value) {
+#define EGRET_CLASS(x) if (strcmp(name, #x) == 0) { *value = SBBidiType##x; return 1; }
+    EGRET_CLASS(L) EGRET_CLASS(R) EGRET_CLASS(AL) EGRET_CLASS(EN)
+    EGRET_CLASS(ES) EGRET_CLASS(ET) EGRET_CLASS(AN) EGRET_CLASS(CS)
+    EGRET_CLASS(B) EGRET_CLASS(S) EGRET_CLASS(WS) EGRET_CLASS(ON)
+    EGRET_CLASS(LRE) EGRET_CLASS(LRO) EGRET_CLASS(RLE) EGRET_CLASS(RLO)
+    EGRET_CLASS(PDF) EGRET_CLASS(NSM) EGRET_CLASS(BN) EGRET_CLASS(FSI)
+    EGRET_CLASS(LRI) EGRET_CLASS(RLI) EGRET_CLASS(PDI)
+#undef EGRET_CLASS
+    return 0;
+}
+
+const char* EgretSheenLibraryVersion(void) { return SBVersionGetString(); }
+
+EgretSheenCResult EgretSheenObserve(const uint16_t* text, int32_t inputLength,
+        const char* const* classes, int32_t classesMode, int32_t paragraphMode,
+        uint8_t* rawLevels, uint8_t* levels, int32_t* visualToLogical,
+        int32_t* paragraphEnds, uint8_t* paragraphLevels) {
+    EgretSheenCResult out = {0, 0, -1, 0};
+    SBCodepointSequence sequence;
+    SBAlgorithmRef algorithm = NULL;
+    SBParagraphRef paragraph = NULL;
+    SBLineRef line = NULL;
+    SBBidiType* types = NULL;
+    SBLevel base;
+    int32_t offset = 0;
+    int32_t i;
+    if (inputLength < 0 || paragraphMode < 0 || paragraphMode > 3 ||
+            (inputLength && (!text || !rawLevels || !levels || !visualToLogical ||
+                             !paragraphEnds || !paragraphLevels || (classesMode && !classes)))) {
+        out.error = 1; return out;
+    }
+    base = paragraphMode == 0 ? 0 : paragraphMode == 1 ? 1 :
+           paragraphMode == 2 ? SBLevelDefaultLTR : SBLevelDefaultRTL;
+    // SBParagraph's private entry asserts suggestedLength>0. An empty source
+    // has no P1 paragraph; report this explicit bypass, not native success.
+    out.paragraphLevel = (paragraphMode == 1 || paragraphMode == 3) ? 1 : 0;
+    if (!inputLength) { return out; }
+    for (i = 0; i < inputLength; ++i) {
+        rawLevels[i] = levels[i] = 255;
+        visualToLogical[i] = -1;
+    }
+    sequence.stringEncoding = SBStringEncodingUTF16;
+    sequence.stringBuffer = text;
+    sequence.stringLength = (SBUInteger)inputLength;
+    if (classesMode) {
+        types = (SBBidiType*)malloc((size_t)inputLength * sizeof(SBBidiType));
+        if (!types) { out.error = 2; goto done; }
+        for (i = 0; i < inputLength; ++i) {
+            if (!classes[i] || !EgretSheenClass(classes[i], &types[i])) {
+                out.error = 4; goto done;
+            }
+        }
+    } else {
+        algorithm = SBAlgorithmCreate(&sequence);
+        if (!algorithm) { out.error = 2; goto done; }
+    }
+    while (offset < inputLength) {
+        SBUInteger count, runCount, r;
+        int32_t end, visual;
+        const SBRun* runs;
+        const SBLevel* raw;
+        // The original type array drives P1 for classes. Public creation on
+        // PUA carriers would incorrectly classify paragraph separators.
+        paragraph = classesMode
+            ? SBParagraphCreateWithCodepointSequence(&sequence, types,
+                    (SBUInteger)offset, (SBUInteger)(inputLength-offset), base)
+            : SBAlgorithmCreateParagraph(algorithm, (SBUInteger)offset,
+                    (SBUInteger)(inputLength-offset), base);
+        if (!paragraph) { out.error = 2; goto done; }
+        ++out.nativeParagraphsCreated;
+        count = SBParagraphGetLength(paragraph);
+        if (!count || count > (SBUInteger)(inputLength-offset) ||
+                SBParagraphGetOffset(paragraph) != (SBUInteger)offset) {
+            out.error = 3; goto done;
+        }
+        end = offset + (int32_t)count;
+        paragraphEnds[out.paragraphCount] = end;
+        paragraphLevels[out.paragraphCount] = SBParagraphGetBaseLevel(paragraph);
+        if (!out.paragraphCount) { out.paragraphLevel = paragraphLevels[0]; }
+        ++out.paragraphCount;
+        raw = SBParagraphGetLevelsPtr(paragraph);
+        if (!raw) { out.error = 3; goto done; }
+        memcpy(rawLevels + offset, raw, (size_t)count);
+        line = SBParagraphCreateLine(paragraph, (SBUInteger)offset, count);
+        if (!line) { out.error = 2; goto done; }
+        runs = SBLineGetRunsPtr(line);
+        runCount = SBLineGetRunCount(line);
+        if (!runs || !runCount || runCount > count) { out.error = 3; goto done; }
+        visual = offset;
+        for (r = 0; r < runCount; ++r) {
+            SBUInteger start = runs[r].offset, length = runs[r].length, j;
+            if (!length || start < (SBUInteger)offset || start > (SBUInteger)end ||
+                    length > (SBUInteger)end-start || runs[r].level > 126) {
+                out.error = 3; goto done;
+            }
+            for (j = 0; j < length; ++j) {
+                int32_t logical = (int32_t)(start+j);
+                if (levels[logical] != 255 || visual >= end) { out.error = 3; goto done; }
+                levels[logical] = runs[r].level;
+                // Expand already reordered native runs, without solving UBA/L2.
+                visualToLogical[visual++] = (int32_t)(start +
+                        ((runs[r].level & 1) ? length-1-j : j));
+            }
+        }
+        if (visual != end) { out.error = 3; goto done; }
+        SBLineRelease(line); line = NULL;
+        SBParagraphRelease(paragraph); paragraph = NULL;
+        offset = end;
+    }
+done:
+    if (line) { SBLineRelease(line); }
+    if (paragraph) { SBParagraphRelease(paragraph); }
+    if (algorithm) { SBAlgorithmRelease(algorithm); }
+    free(types);
+    return out;
+}
