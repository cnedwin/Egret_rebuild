+
+namespace {
+namespace EgretSheen = SkUnicodes::SheenPrivate;
+
+JSObject EgretSheenIdentity() {
+    auto id=val::object();
+    id.set("library",std::string("SheenBidi"));
+    id.set("profile",std::string("sheen3-icu-boundaries-l2-private-r0"));
+    id.set("sourceCommit",std::string("cfe430e7375a7845b679adae9d51dac6deaa8858"));
+    const char* version=EgretSheenLibraryVersion();
+    id.set("libraryVersion",std::string(version ? version : ""));
+    auto declared=val::object();
+    declared.set("libraryVersion",std::string("3.0.0"));
+    declared.set("unicodeVersion",std::string("17.0.0"));
+    declared.set("bidiTypeTableGitBlob",std::string("9b058f634903dfc6b58401b03598e61d11c17c8e"));
+    declared.set("pairingTableGitBlob",std::string("9cd70637298031dbdfa2cf8c2f7e537380470186"));
+    declared.set("tableEquivalenceQualified",false);
+    id.set("sourceDeclared",declared);
+    auto runtime=val::object();
+    runtime.set("libraryVersion",std::string(version ? version : ""));
+    runtime.set("unicodeVersion",val::null());
+    runtime.set("unicodeVersionNote",std::string("No public runtime Unicode-table-version getter; source declaration is not a runtime report"));
+    id.set("runtimeReported",runtime);
+    id.set("hybridL2",std::string("Sheen X1-I2 + full-paragraph L1; linked ICU pure reorderVisual L2 for paragraph runs"));
+    id.set("wrapLineL1Integrated",false);
+    id.set("scratchMemoryDisabled",true);
+    return id;
+}
+JSObject EgretSheenAttach(JSObject out) {
+    out.set("candidateIdentity",EgretSheenIdentity());
+    out.set("wrapLineL1Integrated",false);
+    return out;
+}
+JSObject EgretSheenRefused(const std::string& operation,const char* reason,int32_t error=0) {
+    auto out=EgretURefused(operation,reason);
+    out.set("errorCode",error); out.set("error",error);
+    out.set("errorDomain",std::string("private-sheen-adapter"));
+    return EgretSheenAttach(out);
+}
+JSArray EgretSheenParagraphs(const EgretSheen::Observation& result) {
+    auto out=val::array();
+    for (const auto& p:result.paragraphs) {
+        auto r=val::object(); r.set("start",p.start); r.set("end",p.end); r.set("level",p.level);
+        out.call<void>("push",r);
+    }
+    return out;
+}
+void EgretSheenFields(JSObject& out,const EgretSheen::Observation& result) {
+    out.set("levels",EgretUNumbers(result.levels));
+    out.set("rawParagraphLevels",EgretUNumbers(result.rawParagraphLevels));
+    out.set("visualToLogical",EgretUNumbers(result.visualToLogical));
+    out.set("paragraphs",EgretSheenParagraphs(result));
+    out.set("paragraphLevel",result.paragraphLevel);
+    out.set("offsetDomain",std::string("utf16-code-units"));
+    out.set("errorCode",result.errorCode); out.set("error",result.errorCode);
+    out.set("errorDomain",std::string("private-sheen-adapter"));
+    out.set("nativeInputLength",result.nativeInputLength);
+    out.set("nativeResultLength",result.nativeResultLength);
+    out.set("nativeParagraphCount",result.paragraphs.size());
+    out.set("nativeParagraphsCreated",result.nativeParagraphsCreated);
+    out.set("nativeParagraphCreationScope",std::string("Primary resolver only; factory iterator/regions subqueries are not counted; not total allocation or disposal evidence"));
+    out.set("nativeParagraphCreated",result.nativeParagraphsCreated>0);
+    out.set("emptyInput",result.nativeInputLength==0);
+    out.set("levelsRead",result.levelsRead);
+    out.set("reorderingMode",0); out.set("reorderingOptions",0);
+    out.set("reorderingModeBasis",std::string("Fixed default-UBA profile identifiers; not Sheen runtime getters"));
+    out.set("levelsScope",std::string("Per-P1 full-paragraph L1; rawParagraphLevels precede L1; no wrapped-line L1 integration"));
+    out.set("permutationInputDomain",std::string("Per-P1 UTF16 level slots, concatenated in source paragraph order; not final wrapped-line glyph runs"));
+}
+bool EgretSheenDirection(const val& value,int32_t* direction) {
+    if (value.typeOf().as<std::string>()!="number") { return false; }
+    const double d=value.as<double>();
+    if (d!=0 && d!=1) { return false; }
+    *direction=static_cast<int32_t>(d); return true;
+}
+
+JSObject GetEgretSheenBidiComparison(val request) {
+    std::string operation;
+    if (request.isNull() || request.isUndefined() ||
+        request.typeOf().as<std::string>()!="object" ||
+        val::global("Array").call<bool>("isArray",request)) {
+        return EgretSheenRefused(operation,"INVALID_REQUEST");
+    }
+    if (!EgretUString(request["operation"],32,&operation)) {
+        return EgretSheenRefused(operation,"INVALID_OPERATION");
+    }
+    if (operation=="identity") {
+        auto out=EgretUStatus("OBSERVED",operation);
+        out.set("commonIcuIdentity",EgretUIdentity(operation));
+        return EgretSheenAttach(out);
+    }
+    if (operation=="breaks" || operation=="paragraphFlags") {
+        auto out=GetEgretUnicodeQualification(request);
+        out.set("serviceBackend",std::string("Unchanged common ICU service"));
+        return EgretSheenAttach(out);
+    }
+    if (operation!="bidiBackend" && operation!="bidiAdapter" && operation!="iteratorProbe") {
+        return EgretSheenRefused(operation,"UNKNOWN_OPERATION");
+    }
+    const bool classesMode=!request["classes"].isUndefined();
+    const bool textMode=!request["textUtf16"].isUndefined();
+    std::u16string text;
+    SkString utf8;
+    std::vector<std::string> classes;
+    EgretSheen::ParagraphMode mode=EgretSheen::ParagraphMode::kLtr;
+    std::string modeName;
+    int32_t direction=0;
+    std::vector<int32_t> probeIndices;
+    if (operation=="bidiBackend") {
+        if (classesMode==textMode) { return EgretSheenRefused(operation,"AMBIGUOUS_BIDI_INPUT"); }
+        if (classesMode) {
+            if (!val::global("Array").call<bool>("isArray",request["classes"])) {
+                return EgretSheenRefused(operation,"INVALID_CLASSES");
+            }
+            size_t count=0;
+            if (!EgretUArrayLength(request["classes"],256,&count)) {
+                return EgretSheenRefused(operation,"CLASS_LIMIT");
+            }
+            for (size_t i=0;i<count;++i) {
+                std::string token;
+                if (!EgretUString(request["classes"][static_cast<unsigned>(i)],3,&token)) {
+                    return EgretSheenRefused(operation,"INVALID_BIDI_CLASS");
+                }
+                classes.push_back(std::move(token));
+            }
+        } else if (const char* reason=EgretUText(request["textUtf16"],&text,&utf8)) {
+            return EgretSheenRefused(operation,reason);
+        }
+        if (!EgretUString(request["paragraphMode"],16,&modeName)) {
+            return EgretSheenRefused(operation,"INVALID_PARAGRAPH_MODE");
+        }
+        if (modeName=="ltr") { mode=EgretSheen::ParagraphMode::kLtr; }
+        else if (modeName=="rtl") { mode=EgretSheen::ParagraphMode::kRtl; }
+        else if (modeName=="auto-ltr") { mode=EgretSheen::ParagraphMode::kAutoLtr; }
+        else if (modeName=="auto-rtl") { mode=EgretSheen::ParagraphMode::kAutoRtl; }
+        else { return EgretSheenRefused(operation,"INVALID_PARAGRAPH_MODE"); }
+    } else {
+        if (classesMode) { return EgretSheenRefused(operation,"INVALID_CLASSES_FOR_ADAPTER"); }
+        if (const char* reason=EgretUText(request["textUtf16"],&text,&utf8)) {
+            return EgretSheenRefused(operation,reason);
+        }
+        if (!EgretSheenDirection(request["direction"],&direction)) {
+            return EgretSheenRefused(operation,"INVALID_DIRECTION");
+        }
+        mode=direction==0 ? EgretSheen::ParagraphMode::kLtr : EgretSheen::ParagraphMode::kRtl;
+    }
+    if (operation=="iteratorProbe") {
+        size_t count=0;
+        if (!EgretUArrayLength(request["probeIndices"],513,&count)) {
+            return EgretSheenRefused(operation,"INVALID_PROBE_INDEX");
+        }
+        for (size_t i=0;i<count;++i) {
+            const val v=request["probeIndices"][static_cast<unsigned>(i)];
+            if (v.typeOf().as<std::string>()!="number") {
+                return EgretSheenRefused(operation,"INVALID_PROBE_INDEX");
+            }
+            const double index=v.as<double>();
+            if (!std::isfinite(index) || std::floor(index)!=index || index<0 || index>text.size()) {
+                return EgretSheenRefused(operation,"INVALID_PROBE_INDEX");
+            }
+            probeIndices.push_back(static_cast<int32_t>(index));
+        }
+    }
+    const auto observed=EgretSheen::Observe(text,classes,classesMode,mode);
+    if (!observed.refusalReason.empty()) {
+        return EgretSheenRefused(operation,observed.refusalReason.c_str(),observed.errorCode);
+    }
+    auto result=observed;
+    auto out=classesMode ? EgretUStatus("OBSERVED",operation)
+                         : EgretUObservedText(operation,text,utf8);
+    out.set("inputKind",std::string(classesMode ? "classes" : "characters"));
+    if (classesMode) {
+        auto copied=val::array();
+        for (const auto& token:classes) { copied.call<void>("push",token); }
+        out.set("classes",copied);
+        out.set("classAssignment",std::string("Original native refBidiTypes in same-unity shim; one non-bracket PUA carrier per token, not representative characters"));
+    }
+    if (operation=="bidiBackend") {
+        out.set("paragraphMode",modeName);
+        out.set("visualMapBackend",std::string("Sheen SBLine L1-L2 native runs"));
+    } else {
+        auto unicode=get_paragraph_unicode();
+        if (!unicode) { return EgretSheenRefused(operation,"UNICODE_UNAVAILABLE"); }
+        // Exercise the actual factory's UTF8 overload. Its temporary UTF16
+        // buffer is retired before these iterator reads; ownedLevels persist.
+        auto iterator=unicode->makeBidiIterator(utf8.c_str(),static_cast<int>(utf8.size()),
+            direction==0 ? SkBidiIterator::kLTR : SkBidiIterator::kRTL);
+        if (!iterator || iterator->getLength()!=static_cast<int32_t>(text.size())) {
+            return EgretSheenRefused(operation,"BIDI_ADAPTER_UNAVAILABLE_OR_LENGTH");
+        }
+        std::vector<uint8_t> ownedLevels;
+        for (size_t i=0;i<text.size();++i) {
+            ownedLevels.push_back(iterator->getLevelAt(static_cast<int32_t>(i)));
+        }
+        if (ownedLevels!=result.levels) { return EgretSheenRefused(operation,"FACTORY_LEVEL_MISMATCH"); }
+        out.set("direction",direction);
+        if (operation=="iteratorProbe") {
+            auto probes=val::array();
+            for (int32_t index:probeIndices) {
+                auto p=val::object(); p.set("index",index);
+                p.set("level",static_cast<int32_t>(iterator->getLevelAt(index)));
+                probes.call<void>("push",p);
+            }
+            out.set("length",iterator->getLength());
+            out.set("ownedLevels",EgretUNumbers(ownedLevels));
+            out.set("probes",probes);
+        }
+        // L2 is applied separately within each P1 range. This is a native
+        // level-slot diagnostic, never a final soft-wrapped glyph map.
+        for (const auto& p:result.paragraphs) {
+            const int32_t count=p.end-p.start;
+            std::vector<int32_t> local(count);
+            unicode->reorderVisual(result.levels.data()+p.start,count,local.data());
+            for (int32_t i=0;i<count;++i) { result.visualToLogical[p.start+i]=p.start+local[i]; }
+        }
+        std::vector<SkUnicode::BidiRegion> regions;
+        if (!unicode->getBidiRegions(utf8.c_str(),static_cast<int>(utf8.size()),
+            direction==0 ? SkUnicode::TextDirection::kLTR : SkUnicode::TextDirection::kRTL,&regions)) {
+            return EgretSheenRefused(operation,"BIDI_REGIONS_REFUSED");
+        }
+        auto copied=val::array();
+        for (const auto& region:regions) {
+            auto p=val::object(); p.set("start",region.start); p.set("end",region.end);
+            p.set("level",static_cast<int32_t>(region.level)); copied.call<void>("push",p);
+        }
+        out.set("regions",copied);
+        out.set("regionOffsetDomain",std::string("utf8-bytes"));
+        out.set("visualMapBackend",std::string("Same paragraph factory; linked ICU pure reorderVisual per P1"));
+    }
+    EgretSheenFields(out,result);
+    return EgretSheenAttach(out);
+}
+}  // namespace
