+// Each line uses native Sheen L1/L2 over its actual range and complete P1 context.
+// Drawable clusters are referenced once; zero-advance formatting source slots do
+// not expand through the global cluster finder and repaint a neighboring glyph.
+void TextLine::prepareFinalBidi() {
+    fFinalFragments.clear();
+    std::vector<SkUnicodes::SheenPrivate::LineAtom> atoms;
+    if(!fOwner->fFinalLineBidi || !fOwner->fFinalLineBidi->atoms(fTextIncludingNewlines.start,fTextIncludingNewlines.end,&atoms))
+        SK_ABORT("Egret final-line bidi range refused");
+    std::vector<uint8_t> seen(fGhostClusterRange.width(),0);
+    fFinalClusterLevels.assign(fGhostClusterRange.width(),-1);
+    auto& levels = fFinalClusterLevels;
+    // A shaping cluster may include default-ignorable controls. Only its
+    // drawable source determines ownership; controls get independent zero slots.
+    for(const auto& atom:atoms){
+        if(atom.logicalControl)continue;
+        auto cluster=fOwner->clusterIndex(atom.start);
+        if(cluster<fGhostClusterRange.start||cluster>=fGhostClusterRange.end)SK_ABORT("Egret final-line cluster range refused");
+        auto& level=levels[cluster-fGhostClusterRange.start];
+        if(level>=0&&level!=atom.level)SK_ABORT("Egret final-line mixed drawable cluster levels");
+        level=atom.level;
+    }
+    for(const auto& atom:atoms){
+        const auto index=fOwner->clusterIndex(atom.start);
+        if(index<fGhostClusterRange.start||index>=fGhostClusterRange.end)SK_ABORT("Egret final-line source outside clusters");
+        const auto& cluster=fOwner->cluster(index);
+        const auto source=cluster.runIndex();
+        if(atom.logicalControl){
+            fFinalFragments.push_back({source,{atom.start,atom.end},{index,index},atom.level,true,true});
+            continue;
+        }
+        if(seen[index-fGhostClusterRange.start])continue;
+        seen[index-fGhostClusterRange.start]=1;
+        auto text=intersected(cluster.textRange(), fTextIncludingNewlines);
+        bool controls=false;for(auto byte=text.start;byte<text.end;++byte)controls|=fOwner->fFinalLineBidi->controlAt(byte);
+        BidiFragment next{source,text,{index,index+1},atom.level,false,controls};
+        auto& run=fOwner->run(source);
+        // Merge only unchanged storage direction. Reset-direction spaces remain
+        // one cluster each, so canonical glyph order is never falsely reversed.
+        if(!fFinalFragments.empty()&&!controls&&run.fBidiLevel==atom.level){
+            auto& previous=fFinalFragments.back();
+            bool adjacent=(atom.level&1)?next.text.end==previous.text.start:previous.text.end==next.text.start;
+            if(!previous.logicalOnly&&!previous.hasControls&&previous.run==source&&previous.level==atom.level&&adjacent){
+                previous.text={std::min(previous.text.start,next.text.start),std::max(previous.text.end,next.text.end)};
+                previous.clusters={std::min(previous.clusters.start,next.clusters.start),std::max(previous.clusters.end,next.clusters.end)};
+                continue;
+            }
+        }
+        fFinalFragments.push_back(next);
+    }
+    // Placeholders retain the original API's source-order assignment.
+    std::vector<RunIndex> placeholders;
+    for(auto run:fRunsInVisualOrder)if(fOwner->run(run).isPlaceholder())placeholders.push_back(run);
+    std::sort(placeholders.begin(),placeholders.end());size_t p=0;
+    for(auto& fragment:fFinalFragments)if(!fragment.logicalOnly&&fOwner->run(fragment.run).isPlaceholder()){
+        if(p>=placeholders.size())SK_ABORT("Egret final-line placeholder range refused");
+        fragment.run=placeholders[p++];fragment.text=fOwner->run(fragment.run).textRange();fragment.clusters=fOwner->run(fragment.run).clusterRange();
+    }
+    fFinalBidiReady=true;
+    fTextBlobCache.clear();fTextBlobCachePopulated=false;
+}
+TextRange TextLine::logicalVisibleRange(TextRange text) const {
+    if(!fOwner->fFinalLineBidi)return text;
+    while(text.start<text.end&&fOwner->fFinalLineBidi->controlAt(text.start))++text.start;
+    while(text.end>text.start&&fOwner->fFinalLineBidi->controlAt(text.end-1))--text.end;
+    return text;
+}
+bool TextLine::hasLogicalVisibleText(TextRange text) const {
+    for(auto byte=text.start;byte<text.end;++byte)if(!fOwner->fFinalLineBidi->controlAt(byte))return true;
+    return false;
+}
+bool TextLine::finalClusterLeftToRight(const Cluster* cluster) const {
+    if (fFinalBidiReady) {
+        const auto index = fOwner->clusterIndex(cluster->textRange().start);
+        if (index >= fGhostClusterRange.start && index < fGhostClusterRange.end) {
+            const int level = fFinalClusterLevels[index - fGhostClusterRange.start];
+            if (level >= 0) return (level & 1) == 0;
+        }
+    }
+    return cluster->run().leftToRight();
+}
+void TextLine::iterateFinalFragments(bool ghosts,const RunVisitor& visitor) const {
+    SkScalar width=0,offset=0,total=0;
+    if(fEllipsis&&fOwner->paragraphStyle().getTextDirection()==TextDirection::kRtl){offset=fEllipsis->offset().fX;visitor(fEllipsis.get(),offset,fEllipsis->textRange(),&width,nullptr);offset+=width;total+=width;}
+    if(fHyphen&&fOwner->paragraphStyle().getTextDirection()==TextDirection::kRtl){visitor(fHyphen.get(),offset,fHyphen->textRange(),&width,nullptr);offset+=width;total+=width;}
+    if(ghosts&&fOwner->paragraphStyle().getTextDirection()==TextDirection::kRtl){
+        SkScalar trailing=0;
+        for(const auto& fragment:fFinalFragments){
+            if(fragment.logicalOnly)continue;
+            auto text=intersected(fragment.text, {fTextExcludingSpaces.end,fTextIncludingNewlines.end});
+            if(text.start < text.end)trailing+=measureTextInsideOneRun(text,&fOwner->run(fragment.run),0,0,true,TextAdjustment::GlyphCluster).clip.width();
+        }
+        offset-=trailing;
+    }
+    const auto accepted=ghosts?fTextIncludingNewlines:fTextExcludingSpaces;
+    for(const auto& fragment:fFinalFragments){
+        auto text=intersected(fragment.text, accepted);
+        if(text.start >= text.end||(!ghosts&&fragment.logicalOnly))continue;
+        width=0;
+        if(!visitor(&fOwner->run(fragment.run),offset,text,&width,&fragment))return;
+        // Selection visitors clip ghost glyphs to the ink width. Layout offsets
+        // must still advance by the complete source fragment's canonical width.
+        if (fragment.logicalOnly) width = 0;
+        else if (ghosts) width = measureTextInsideOneRun(text, &fOwner->run(fragment.run),
+            offset, 0, true, TextAdjustment::GlyphCluster).clip.width();
+        offset+=width;total+=width;
+    }
+    if(fEllipsis&&fOwner->paragraphStyle().getTextDirection()==TextDirection::kLtr){visitor(fEllipsis.get(),offset,fEllipsis->textRange(),&width,nullptr);offset+=width;total+=width;}
+    if(fHyphen&&fOwner->paragraphStyle().getTextDirection()==TextDirection::kLtr){visitor(fHyphen.get(),offset,fHyphen->textRange(),&width,nullptr);total+=width;}
+    if(!ghosts&&compareRound(total,this->width(),fOwner->getApplyRoundingHack())!=0)SkDEBUGFAILF("Final bidi width: %f != %f",total,this->width());
+}
