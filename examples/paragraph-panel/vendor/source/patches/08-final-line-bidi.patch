+// A context owns every solved P1 paragraph while borrowing the C++ owner's immutable UTF16.
+typedef struct EgretSheenP1 {
+    SBParagraphRef paragraph;
+    int32_t start, end;
+    struct EgretSheenP1* next;
+} EgretSheenP1;
+struct EgretSheenLineContext {
+    SBAlgorithmRef algorithm;
+    const uint16_t* text;
+    int32_t length;
+    EgretSheenP1* first;
+};
+void EgretSheenReleaseLineContext(EgretSheenLineContext* context) {
+    if (context) {
+        EgretSheenP1* p = context->first;
+        while (p) { EgretSheenP1* next=p->next; SBParagraphRelease(p->paragraph); free(p); p=next; }
+        if (context->algorithm) SBAlgorithmRelease(context->algorithm);
+        free(context);
+    }
+}
+EgretSheenLineContext* EgretSheenCreateLineContext(const uint16_t* text, int32_t length, int32_t rtl) {
+    EgretSheenLineContext* context;
+    SBCodepointSequence sequence;
+    EgretSheenP1** tail;
+    int32_t offset=0;
+    if (length<0 || (length && !text) || (rtl!=0 && rtl!=1)) return NULL;
+    context=(EgretSheenLineContext*)calloc(1,sizeof(*context));
+    if (!context) return NULL;
+    context->text=text; context->length=length;
+    if (!length) return context;
+    sequence.stringEncoding=SBStringEncodingUTF16; sequence.stringBuffer=text; sequence.stringLength=(SBUInteger)length;
+    context->algorithm=SBAlgorithmCreate(&sequence);
+    if (!context->algorithm) { EgretSheenReleaseLineContext(context); return NULL; }
+    tail=&context->first;
+    while (offset<length) {
+        SBParagraphRef paragraph=SBAlgorithmCreateParagraph(context->algorithm,(SBUInteger)offset,(SBUInteger)(length-offset),rtl?1:0);
+        SBUInteger count;
+        EgretSheenP1* entry;
+        if (!paragraph) { EgretSheenReleaseLineContext(context); return NULL; }
+        count=SBParagraphGetLength(paragraph);
+        if (!count || count>(SBUInteger)(length-offset) || SBParagraphGetOffset(paragraph)!=(SBUInteger)offset) {
+            SBParagraphRelease(paragraph); EgretSheenReleaseLineContext(context); return NULL;
+        }
+        entry=(EgretSheenP1*)calloc(1,sizeof(*entry));
+        if (!entry) { SBParagraphRelease(paragraph); EgretSheenReleaseLineContext(context); return NULL; }
+        entry->paragraph=paragraph; entry->start=offset; entry->end=offset+(int32_t)count;
+        *tail=entry; tail=&entry->next; offset=entry->end;
+    }
+    return context;
+}
+int32_t EgretSheenReadLine(EgretSheenLineContext* context, int32_t start, int32_t end,
+                          EgretSheenLineRun* output, int32_t capacity) {
+    EgretSheenP1* paragraph;
+    int32_t count=0,covered=start;
+    if (!context || start<0 || start>end || end>context->length || capacity<0 || (capacity && !output)) return -1;
+    if (start==end) return 0;
+    for (paragraph=context->first; paragraph && covered<end; paragraph=paragraph->next) {
+        int32_t first=start>paragraph->start?start:paragraph->start;
+        int32_t last=end<paragraph->end?end:paragraph->end;
+        SBLineRef line; const SBRun* runs; SBUInteger n,i;
+        if (first>=last) continue;
+        if (first!=covered) return -1;
+        line=SBParagraphCreateLine(paragraph->paragraph,(SBUInteger)first,(SBUInteger)(last-first));
+        if (!line) return -1;
+        runs=SBLineGetRunsPtr(line);n=SBLineGetRunCount(line);
+        if (!runs || !n || n>(SBUInteger)(capacity-count)) { SBLineRelease(line); return -1; }
+        for (i=0;i<n;++i) {
+            if (!runs[i].length || runs[i].offset<(SBUInteger)first || runs[i].offset>(SBUInteger)last ||
+                runs[i].length>(SBUInteger)last-runs[i].offset || runs[i].level>126) { SBLineRelease(line); return -1; }
+            output[count].start=(int32_t)runs[i].offset; output[count].end=(int32_t)(runs[i].offset+runs[i].length);
+            output[count++].level=runs[i].level;
+        }
+        SBLineRelease(line);covered=last;
+    }
+    return covered==end?count:-1;
+}
+int32_t EgretSheenLogicalControlAt(EgretSheenLineContext* context, int32_t index) {
+    const SBBidiType* types; uint16_t unit;
+    if (!context || !context->algorithm || index<0 || index>=context->length) return 0;
+    unit=context->text[index];
+    if (unit==0x061C || unit==0x200E || unit==0x200F) return 1;
+    types=SBAlgorithmGetBidiTypesPtr(context->algorithm);
+    switch(types[index]) {
+        case SBBidiTypeBN: case SBBidiTypeLRE: case SBBidiTypeRLE:
+        case SBBidiTypeLRO: case SBBidiTypeRLO: case SBBidiTypePDF:
+        case SBBidiTypeLRI: case SBBidiTypeRLI: case SBBidiTypeFSI:
+        case SBBidiTypePDI: case SBBidiTypeB: return 1;
+        default: return 0;
+    }
+}
