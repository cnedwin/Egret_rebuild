+LineContext::~LineContext() { EgretSheenReleaseLineContext(fNative); }
+std::unique_ptr<LineContext> LineContext::Make(const char* text, int bytes, SkUnicode::TextDirection dir) {
+    if (bytes<0 || (bytes && !text)) return nullptr;
+    auto context=std::unique_ptr<LineContext>(new(std::nothrow) LineContext());
+    if (!context || !FromUtf8(text,bytes,&context->fText)) return nullptr;
+    context->fByteAt.assign(context->fText.size()+1,-1);
+    context->fUnitAt.assign(static_cast<size_t>(bytes)+1,-1);
+    context->fControlBytes.assign(static_cast<size_t>(bytes),0);
+    context->fNative=EgretSheenCreateLineContext(reinterpret_cast<const uint16_t*>(context->fText.data()),
+        static_cast<int32_t>(context->fText.size()),dir==SkUnicode::TextDirection::kRTL?1:0);
+    if (!context->fNative) return nullptr;
+    const char* cursor=text; const char* end=bytes?text+bytes:text; size_t unit=0;
+    context->fByteAt[0]=0;context->fUnitAt[0]=0;
+    while (cursor!=end) {
+        size_t byte=static_cast<size_t>(cursor-text);
+        auto cp=SkUTF::NextUTF8(&cursor,end);if(cp<0)return nullptr;
+        size_t next=static_cast<size_t>(cursor-text);
+        if (EgretSheenLogicalControlAt(context->fNative,static_cast<int32_t>(unit)))
+            std::fill(context->fControlBytes.begin()+byte,context->fControlBytes.begin()+next,1);
+        unit+=cp>0xFFFF?2:1;
+        context->fByteAt[unit]=static_cast<int32_t>(next);context->fUnitAt[next]=static_cast<int32_t>(unit);
+    }
+    if(unit!=context->fText.size())return nullptr;
+    return context;
+}
+bool LineContext::atoms(size_t start, size_t end, std::vector<LineAtom>* output) const {
+    if (!output || start>end || end>=fUnitAt.size() || fUnitAt[start]<0 || fUnitAt[end]<0) return false;
+    const int32_t first=fUnitAt[start],last=fUnitAt[end];
+    std::vector<EgretSheenLineRun> runs(static_cast<size_t>(last-first));
+    const int32_t count=EgretSheenReadLine(fNative,first,last,runs.data(),static_cast<int32_t>(runs.size()));
+    if(count<0)return false;
+    std::vector<LineAtom> complete;
+    for(int32_t r=0;r<count;++r){
+        const auto& run=runs[r];
+        if(run.start<first || run.end>last || fByteAt[run.start]<0 || fByteAt[run.end]<0)return false;
+        if((run.level&1)==0){
+            for(int32_t i=run.start;i<run.end;){int32_t next=i+1;while(next<run.end&&fByteAt[next]<0)++next;
+                if(fByteAt[next]<0)return false;
+                size_t byte=static_cast<size_t>(fByteAt[i]);complete.push_back({byte,static_cast<size_t>(fByteAt[next]),run.level,controlAt(byte)});i=next;}
+        }else{
+            for(int32_t i=run.end;i>run.start;){int32_t previous=i-1;while(previous>run.start&&fByteAt[previous]<0)--previous;
+                if(fByteAt[previous]<0)return false;
+                size_t byte=static_cast<size_t>(fByteAt[previous]);complete.push_back({byte,static_cast<size_t>(fByteAt[i]),run.level,controlAt(byte)});i=previous;}
+        }
+    }
+    output->swap(complete);return true;
+}
+} // namespace SkUnicodes::SheenPrivate
