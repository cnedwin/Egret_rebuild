+// Local private qualification extension to the pinned Skia tree.
+// Governed by the BSD license retained as LICENSE.skia; not a public API.
+#ifndef SkUnicode_egret_qualification_DEFINED
+#define SkUnicode_egret_qualification_DEFINED
+
+#include <array>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace SkUnicodes::ICU::EgretQualification {
+
+struct Identity {
+    std::array<uint8_t, 4> codeVersion{};
+    std::array<uint8_t, 4> unicodeVersion{};
+    std::array<uint8_t, 4> dataVersion{};
+    int32_t dataErrorCode = 0;
+    std::string defaultLocale;
+    std::string declaredCodeVersion;
+    std::string declaredUnicodeVersion;
+};
+Identity ObserveIdentity();
+
+enum class ParagraphMode { kLtr, kRtl, kAutoLtr, kAutoRtl };
+struct BidiObservation {
+    std::vector<uint8_t> levels;
+    std::vector<int32_t> visualToLogical;
+    int32_t paragraphLevel = -1;
+    int32_t errorCode = 0;
+    int32_t nativeInputLength = -1;
+    int32_t nativeResultLength = -1;
+    int32_t reorderingMode = -1;
+    uint32_t reorderingOptions = 0;
+    bool levelsRead = false;
+    std::string refusalReason;
+};
+// classesMode is explicit even for an empty class list; neither representation
+// is guessed from content. The caller validates well-formed UTF-16 first.
+BidiObservation ObserveBidi(const std::u16string& text,
+                            const std::vector<std::string>& classes,
+                            bool classesMode,
+                            ParagraphMode mode);
+
+}  // namespace SkUnicodes::ICU::EgretQualification
