+namespace {
+bool EgretClass(const std::string& name, UCharDirection* direction) {
+    struct Entry { const char* name; UCharDirection direction; };
+    static constexpr Entry entries[] = {
+        {"L", U_LEFT_TO_RIGHT}, {"R", U_RIGHT_TO_LEFT},
+        {"AL", U_RIGHT_TO_LEFT_ARABIC}, {"EN", U_EUROPEAN_NUMBER},
+        {"ES", U_EUROPEAN_NUMBER_SEPARATOR}, {"ET", U_EUROPEAN_NUMBER_TERMINATOR},
+        {"AN", U_ARABIC_NUMBER}, {"CS", U_COMMON_NUMBER_SEPARATOR},
+        {"NSM", U_DIR_NON_SPACING_MARK}, {"BN", U_BOUNDARY_NEUTRAL},
+        {"B", U_BLOCK_SEPARATOR}, {"S", U_SEGMENT_SEPARATOR},
+        {"WS", U_WHITE_SPACE_NEUTRAL}, {"ON", U_OTHER_NEUTRAL},
+        {"LRE", U_LEFT_TO_RIGHT_EMBEDDING}, {"LRO", U_LEFT_TO_RIGHT_OVERRIDE},
+        {"RLE", U_RIGHT_TO_LEFT_EMBEDDING}, {"RLO", U_RIGHT_TO_LEFT_OVERRIDE},
+        {"PDF", U_POP_DIRECTIONAL_FORMAT}, {"LRI", U_LEFT_TO_RIGHT_ISOLATE},
+        {"RLI", U_RIGHT_TO_LEFT_ISOLATE}, {"FSI", U_FIRST_STRONG_ISOLATE},
+        {"PDI", U_POP_DIRECTIONAL_ISOLATE},
+    };
+    for (const auto& entry : entries) {
+        if (name == entry.name) { *direction = entry.direction; return true; }
+    }
+    return false;
+}
+
+UCharDirection U_CALLCONV EgretClassCallback(const void* context, UChar32 value) {
+    const auto& classes = *static_cast<const std::vector<UCharDirection>*>(context);
+    const int32_t index = value - 0xE000;
+    return index >= 0 && static_cast<size_t>(index) < classes.size()
+        ? classes[index] : static_cast<UCharDirection>(U_BIDI_CLASS_DEFAULT);
+}
+}  // namespace
+
+BidiObservation ObserveBidi(const std::u16string& text,
+                            const std::vector<std::string>& classes,
+                            bool classesMode,
+                            ParagraphMode mode) {
+    BidiObservation out;
+    // Declare buffers/context before UBiDi: its stored pointers remain valid
+    // until the RAII UBiDi is destroyed, including all early return paths.
+    std::u16string nativeText = text;
+    std::vector<UCharDirection> nativeClasses;
+    if (text.size() > 512 || classes.size() > 256) {
+        out.refusalReason = "BIDI_INPUT_LIMIT";
+        return out;
+    }
+    if (classesMode) {
+        nativeText.clear();
+        nativeClasses.reserve(classes.size());
+        for (size_t i = 0; i < classes.size(); ++i) {
+            UCharDirection direction;
+            if (!EgretClass(classes[i], &direction)) {
+                out.refusalReason = "INVALID_BIDI_CLASS";
+                return out;
+            }
+            nativeClasses.push_back(direction);
+            // Private one-unit carriers, with each class assigned by ICU's
+            // callback. They are not representative original characters.
+            nativeText.push_back(static_cast<char16_t>(0xE000 + i));
+        }
+    }
+    UBiDiLevel level;
+    switch (mode) {
+        case ParagraphMode::kLtr: level = UBIDI_LTR; break;
+        case ParagraphMode::kRtl: level = UBIDI_RTL; break;
+        case ParagraphMode::kAutoLtr: level = UBIDI_DEFAULT_LTR; break;
+        case ParagraphMode::kAutoRtl: level = UBIDI_DEFAULT_RTL; break;
+        default: out.refusalReason = "INVALID_PARAGRAPH_MODE"; return out;
+    }
+    UErrorCode error = U_ZERO_ERROR;
+    std::unique_ptr<UBiDi, decltype(&ubidi_close)> bidi(
+        ubidi_openSized(static_cast<int32_t>(nativeText.size()), 0, &error), &ubidi_close);
+    auto failed = [&]() {
+        out.errorCode = static_cast<int32_t>(error);
+        if (!U_FAILURE(error)) { return false; }
+        out.refusalReason = "ICU_BIDI_ERROR";
+        return true;
+    };
+    if (failed() || !bidi) {
+        if (out.refusalReason.empty()) { out.refusalReason = "ICU_BIDI_ALLOCATION"; }
+        return out;
+    }
+    if (classesMode) {
+        ubidi_setClassCallback(bidi.get(), &EgretClassCallback, &nativeClasses,
+                              nullptr, nullptr, &error);
+        if (failed()) { return out; }
+    }
+    // c_str() is non-null even for length zero, as required by ubidi_setPara.
+    ubidi_setPara(bidi.get(), reinterpret_cast<const UChar*>(nativeText.c_str()),
+                  static_cast<int32_t>(nativeText.size()), level, nullptr, &error);
+    if (failed()) { return out; }
+    out.nativeInputLength = ubidi_getLength(bidi.get());
+    out.nativeResultLength = ubidi_getResultLength(bidi.get());
+    out.paragraphLevel = ubidi_getParaLevel(bidi.get());
+    out.reorderingMode = static_cast<int32_t>(ubidi_getReorderingMode(bidi.get()));
+    out.reorderingOptions = ubidi_getReorderingOptions(bidi.get());
+    if (out.nativeInputLength != static_cast<int32_t>(nativeText.size()) ||
+        out.nativeResultLength < 0 || out.nativeResultLength > 512) {
+        out.refusalReason = "BIDI_OUTPUT_LENGTH";
+        return out;
+    }
+    if (nativeText.empty()) {
+        // ICU getLevels explicitly rejects empty text. This successful setPara
+        // observation does not claim that getLevels was called/succeeded.
+        return out;
+    }
+    const UBiDiLevel* levels = ubidi_getLevels(bidi.get(), &error);
+    if (failed() || !levels) {
+        if (out.refusalReason.empty()) { out.refusalReason = "ICU_BIDI_LEVELS"; }
+        return out;
+    }
+    out.levels.assign(levels, levels + nativeText.size());
+    out.levelsRead = true;
+    out.visualToLogical.reserve(out.nativeResultLength);
+    for (int32_t i = 0; i < out.nativeResultLength; ++i) {
+        const int32_t logical = ubidi_getLogicalIndex(bidi.get(), i, &error);
+        if (failed()) { return out; }
+        if (logical < 0 || logical >= out.nativeInputLength) {
+            out.refusalReason = "BIDI_OUTPUT_INDEX";
+            return out;
+        }
+        out.visualToLogical.push_back(logical);
+    }
+    return out;
+}
+
