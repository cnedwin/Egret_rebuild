+// Local private qualification extension to pinned Skia. Not a public API.
+// Governed by the retained LICENSE.skia and linked ICU's original notices.
+#include "modules/skunicode/src/SkUnicode_egret_qualification.h"
+#include <cmath>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace {
+namespace EgretUnicode = SkUnicodes::ICU::EgretQualification;
+
+JSObject EgretUStatus(const char* status, const std::string& operation) {
+    auto out = val::object();
+    out.set("status", std::string(status));
+    out.set("operation", operation);
+    return out;
+}
+JSObject EgretURefused(const std::string& operation, const char* reason) {
+    auto out = EgretUStatus("REFUSED", operation);
+    out.set("reason", std::string(reason));
+    return out;
+}
+bool EgretUString(const val& value, size_t bound, std::string* copied) {
+    if (value.typeOf().as<std::string>() != "string" ||
+        value["length"].as<double>() > static_cast<double>(bound)) { return false; }
+    *copied = value.as<std::string>();
+    return true;
+}
+bool EgretUArrayLength(const val& value, size_t bound, size_t* length) {
+    if (!val::global("Array").call<bool>("isArray", value)) { return false; }
+    const double count = value["length"].as<double>();
+    if (!std::isfinite(count) || count < 0 || std::floor(count) != count ||
+        count > static_cast<double>(bound)) { return false; }
+    *length = static_cast<size_t>(count);
+    return true;
+}
+template <typename Values> JSArray EgretUNumbers(const Values& values) {
+    auto out = val::array();
+    for (auto value : values) { out.call<void>("push", static_cast<int32_t>(value)); }
+    return out;
+}
+JSArray EgretUBytes(const char* bytes, size_t size) {
+    auto out = val::array();
+    for (size_t i = 0; i < size; ++i) {
+        out.call<void>("push", static_cast<uint32_t>(static_cast<uint8_t>(bytes[i])));
+    }
+    return out;
+}
+const char* EgretUText(const val& value, std::u16string* text, SkString* utf8) {
+    if (!val::global("Array").call<bool>("isArray", value)) { return "INVALID_TEXT_UTF16"; }
+    size_t count = 0;
+    if (!EgretUArrayLength(value, 512, &count)) { return "UTF16_LIMIT"; }
+    text->reserve(count);
+    for (size_t i = 0; i < count; ++i) {
+        const val unit = value[static_cast<unsigned>(i)];
+        if (unit.typeOf().as<std::string>() != "number") { return "INVALID_TEXT_UTF16"; }
+        const double number = unit.as<double>();
+        if (!std::isfinite(number) || number < 0 || number > 65535 ||
+            std::floor(number) != number) { return "INVALID_TEXT_UTF16"; }
+        text->push_back(static_cast<char16_t>(number));
+    }
+    for (size_t i = 0; i < count; ++i) {
+        const uint16_t unit = (*text)[i];
+        if (unit >= 0xD800 && unit <= 0xDBFF) {
+            if (i + 1 == count || (*text)[i + 1] < 0xDC00 || (*text)[i + 1] > 0xDFFF) {
+                return "MALFORMED_UTF16";
+            }
+            ++i;
+        } else if (unit >= 0xDC00 && unit <= 0xDFFF) { return "MALFORMED_UTF16"; }
+    }
+    // Explicit length conversion preserves NUL. Malformed units never reach it.
+    *utf8 = SkUnicode::convertUtf16ToUtf8(text->c_str(), static_cast<int>(text->size()));
+    if (utf8->size() > 2048) { return "UTF8_LIMIT"; }
+    return nullptr;
+}
+JSObject EgretUObservedText(const std::string& operation, const std::u16string& text,
+                           const SkString& utf8) {
+    auto out = EgretUStatus("OBSERVED", operation);
+    out.set("textUtf16", EgretUNumbers(text));
+    out.set("inputUtf8", EgretUBytes(utf8.c_str(), utf8.size()));
+    return out;
+}
+JSObject EgretUIdentity(const std::string& operation) {
+    const auto identity = EgretUnicode::ObserveIdentity();
+    auto out = EgretUStatus("OBSERVED", operation);
+    out.set("codeVersion", EgretUNumbers(identity.codeVersion));
+    out.set("unicodeVersion", EgretUNumbers(identity.unicodeVersion));
+    out.set("dataVersion", EgretUNumbers(identity.dataVersion));
+    out.set("dataErrorCode", identity.dataErrorCode);
+    out.set("defaultLocale", identity.defaultLocale);
+    auto source = val::object();
+    source.set("codeVersion", identity.declaredCodeVersion);
+    source.set("unicodeVersion", identity.declaredUnicodeVersion);
+    out.set("sourceDeclared", source);
+    auto embedded = val::object();
+    embedded.set("bytes", 864880);
+    embedded.set("sha256", std::string("325a86063d26334c2eabe1743cea073b612540fbf3d8fc2ef0b5708e3763a8c7"));
+    embedded.set("sourcePath", std::string("third_party/externals/icu/flutter/icudtl.dat"));
+    embedded.set("identityKind", std::string("reviewed-build-input-sha256-not-runtime-computed"));
+    out.set("embeddedData", embedded);
+    auto runtime = val::object();
+    runtime.set("codeVersion", EgretUNumbers(identity.codeVersion));
+    runtime.set("unicodeVersion", EgretUNumbers(identity.unicodeVersion));
+    runtime.set("dataVersion", EgretUNumbers(identity.dataVersion));
+    runtime.set("dataErrorCode", identity.dataErrorCode);
+    runtime.set("defaultLocale", identity.defaultLocale);
+    out.set("runtimeReported", runtime);
+    return out;
+}
+
+JSObject GetEgretUnicodeQualification(val request) {
+    std::string operation;
+    if (request.isNull() || request.isUndefined() ||
+        request.typeOf().as<std::string>() != "object" ||
+        val::global("Array").call<bool>("isArray", request)) {
+        return EgretURefused(operation, "INVALID_REQUEST");
+    }
+    if (!EgretUString(request["operation"], 32, &operation)) {
+        return EgretURefused(operation, "INVALID_OPERATION");
+    }
+    if (operation == "identity") { return EgretUIdentity(operation); }
+    if (operation != "breaks" && operation != "paragraphFlags" &&
+        operation != "bidiAdapter" && operation != "bidiBackend") {
+        return EgretURefused(operation, "UNKNOWN_OPERATION");
+    }
+    std::u16string text;
+    SkString utf8;
+
+    if (operation == "bidiBackend") {
+        const bool classesMode = !request["classes"].isUndefined();
+        const bool textMode = !request["textUtf16"].isUndefined();
+        if (classesMode == textMode) { return EgretURefused(operation, "AMBIGUOUS_BIDI_INPUT"); }
+        std::vector<std::string> classes;
+        if (classesMode) {
+            if (!val::global("Array").call<bool>("isArray", request["classes"])) {
+                return EgretURefused(operation, "INVALID_CLASSES");
+            }
+            size_t count = 0;
+            if (!EgretUArrayLength(request["classes"], 256, &count)) {
+                return EgretURefused(operation, "CLASS_LIMIT");
+            }
+            classes.reserve(count);
+            for (size_t i = 0; i < count; ++i) {
+                std::string token;
+                if (!EgretUString(request["classes"][static_cast<unsigned>(i)], 3, &token)) {
+                    return EgretURefused(operation, "INVALID_BIDI_CLASS");
+                }
+                classes.push_back(std::move(token));
+            }
+        } else if (const char* reason = EgretUText(request["textUtf16"], &text, &utf8)) {
+            return EgretURefused(operation, reason);
+        }
+        std::string mode;
+        if (!EgretUString(request["paragraphMode"], 16, &mode)) {
+            return EgretURefused(operation, "INVALID_PARAGRAPH_MODE");
+        }
+        EgretUnicode::ParagraphMode paragraphMode;
+        if (mode == "ltr") { paragraphMode = EgretUnicode::ParagraphMode::kLtr; }
+        else if (mode == "rtl") { paragraphMode = EgretUnicode::ParagraphMode::kRtl; }
+        else if (mode == "auto-ltr") { paragraphMode = EgretUnicode::ParagraphMode::kAutoLtr; }
+        else if (mode == "auto-rtl") { paragraphMode = EgretUnicode::ParagraphMode::kAutoRtl; }
+        else { return EgretURefused(operation, "INVALID_PARAGRAPH_MODE"); }
+        const auto result = EgretUnicode::ObserveBidi(text, classes, classesMode, paragraphMode);
+        if (!result.refusalReason.empty()) {
+            auto out = EgretURefused(operation, result.refusalReason.c_str());
+            out.set("errorCode", result.errorCode);
+            out.set("error", result.errorCode);
+            return out;
+        }
+        auto out = classesMode ? EgretUStatus("OBSERVED", operation)
+                               : EgretUObservedText(operation, text, utf8);
+        out.set("inputKind", std::string(classesMode ? "classes" : "characters"));
+        if (classesMode) {
+            auto copied = val::array();
+            for (const auto& token : classes) { copied.call<void>("push", token); }
+            out.set("classes", copied);
+            out.set("classAssignment", std::string("ICU per-token class callback; private one-UTF16-unit carriers, not original characters"));
+        }
+        out.set("paragraphMode", mode);
+        out.set("offsetDomain", std::string("utf16-code-units"));
+        out.set("levels", EgretUNumbers(result.levels));
+        out.set("visualToLogical", EgretUNumbers(result.visualToLogical));
+        out.set("paragraphLevel", result.paragraphLevel);
+        out.set("errorCode", result.errorCode);
+        out.set("error", result.errorCode);
+        out.set("nativeInputLength", result.nativeInputLength);
+        out.set("nativeResultLength", result.nativeResultLength);
+        out.set("levelsRead", result.levelsRead);
+        out.set("reorderingMode", result.reorderingMode);
+        out.set("reorderingOptions", result.reorderingOptions);
+        return out;
+    }
+
+    if (const char* reason = EgretUText(request["textUtf16"], &text, &utf8)) {
+        return EgretURefused(operation, reason);
+    }
+    if (operation == "breaks") {
+        std::string kind, encoding, locale;
+        if (!EgretUString(request["kind"], 16, &kind) ||
+            (kind != "graphemes" && kind != "lines")) { return EgretURefused(operation, "INVALID_BREAK_KIND"); }
+        if (!EgretUString(request["encoding"], 16, &encoding) ||
+            (encoding != "utf16" && encoding != "utf8")) { return EgretURefused(operation, "INVALID_ENCODING"); }
+        const val requestedLocale = request["locale"];
+        const bool defaultLocale = requestedLocale.isNull();
+        if (!defaultLocale && (!EgretUString(requestedLocale, 2, &locale) || locale != "en")) {
+            return EgretURefused(operation, "INVALID_LOCALE");
+        }
+        auto unicode = get_unicode();
+        if (!unicode) { return EgretURefused(operation, "UNICODE_UNAVAILABLE"); }
+        auto iterator = unicode->makeBreakIterator(defaultLocale ? nullptr : locale.c_str(),
+            kind == "graphemes" ? SkUnicode::BreakType::kGraphemes : SkUnicode::BreakType::kLines);
+        if (!iterator) { return EgretURefused(operation, "BREAK_ITERATOR_UNAVAILABLE"); }
+        const bool accepted = encoding == "utf16"
+            ? iterator->setText(text.c_str(), static_cast<int>(text.size()))
+            : iterator->setText(utf8.c_str(), static_cast<int>(utf8.size()));
+        if (!accepted) { return EgretURefused(operation, "BREAK_TEXT_REFUSED"); }
+        const int32_t units = encoding == "utf16" ? static_cast<int32_t>(text.size())
+                                                    : static_cast<int32_t>(utf8.size());
+        std::vector<int32_t> positions, statuses;
+        int32_t position = iterator->first();
+        while (!iterator->isDone()) {
+            if (position < 0 || position > units || positions.size() >= static_cast<size_t>(units) + 1 ||
+                (!positions.empty() && position <= positions.back())) {
+                return EgretURefused(operation, "BREAK_OUTPUT_BOUND_OR_ORDER");
+            }
+            positions.push_back(position);
+            statuses.push_back(iterator->status());
+            position = iterator->next();
+        }
+        auto out = EgretUObservedText(operation, text, utf8);
+        out.set("kind", kind);
+        out.set("encoding", encoding);
+        out.set("offsetDomain", std::string(encoding == "utf16" ? "utf16-code-units" : "utf8-bytes"));
+        out.set("positions", EgretUNumbers(positions));
+        out.set("statuses", EgretUNumbers(statuses));
+        out.set("localeRequested", defaultLocale ? val::null() : val(locale));
+        out.set("defaultLocale", EgretUnicode::ObserveIdentity().defaultLocale);
+        out.set("effectiveLocale", val::null());
+        out.set("effectiveLocaleNote", std::string("SkBreakIterator exposes no effective-locale getter; not inferred"));
+        return out;
+    }
+    if (operation == "paragraphFlags") {
+        if (request["replaceTabs"].typeOf().as<std::string>() != "boolean") {
+            return EgretURefused(operation, "INVALID_REPLACE_TABS");
+        }
+        const bool replaceTabs = request["replaceTabs"].as<bool>();
+        auto unicode = get_unicode();
+        if (!unicode) { return EgretURefused(operation, "UNICODE_UNAVAILABLE"); }
+        std::string bytes(utf8.c_str(), utf8.size());
+        skia_private::TArray<SkUnicode::CodeUnitFlags, true> flags;
+        const bool returned = unicode->computeCodeUnitFlags(bytes.data(), static_cast<int>(bytes.size()), replaceTabs, &flags);
+        if (!returned) { return EgretURefused(operation, "PARAGRAPH_FLAGS_REFUSED"); }
+        if (static_cast<size_t>(flags.size()) != bytes.size() + 1 || flags.size() > 2049) {
+            return EgretURefused(operation, "PARAGRAPH_FLAGS_LENGTH");
+        }
+        auto out = EgretUObservedText(operation, text, utf8);
+        out.set("beforeUtf8", EgretUBytes(utf8.c_str(), utf8.size()));
+        out.set("afterUtf8", EgretUBytes(bytes.data(), bytes.size()));
+        out.set("flags", EgretUNumbers(flags));
+        auto constants = val::object();
+        constants.set("graphemeStart", static_cast<int>(SkUnicode::kGraphemeStart));
+        constants.set("softLineBreakBefore", static_cast<int>(SkUnicode::kSoftLineBreakBefore));
+        constants.set("hardLineBreakBefore", static_cast<int>(SkUnicode::kHardLineBreakBefore));
+        out.set("flagConstants", constants);
+        out.set("offsetDomain", std::string("utf8-bytes"));
+        out.set("terminalSlot", bytes.size());
+        out.set("replaceTabs", replaceTabs);
+        out.set("localeRequested", val::null());
+        out.set("defaultLocale", EgretUnicode::ObserveIdentity().defaultLocale);
+        out.set("effectiveLocale", val::null());
+        out.set("nativeReturned", returned);
+        out.set("scope", std::string("Raw pre-shaping SkUnicode flags; internal extraction failures are not propagated by this native method"));
+        return out;
+    }
+    const val directionValue = request["direction"];
+    if (directionValue.typeOf().as<std::string>() != "number") { return EgretURefused(operation, "INVALID_DIRECTION"); }
+    const double direction = directionValue.as<double>();
+    if (direction != 0 && direction != 1) { return EgretURefused(operation, "INVALID_DIRECTION"); }
+    auto unicode = get_unicode();
+    if (!unicode) { return EgretURefused(operation, "UNICODE_UNAVAILABLE"); }
+    auto iterator = unicode->makeBidiIterator(reinterpret_cast<const uint16_t*>(text.c_str()),
+        static_cast<int>(text.size()), direction == 0 ? SkBidiIterator::kLTR : SkBidiIterator::kRTL);
+    if (!iterator) { return EgretURefused(operation, "BIDI_ADAPTER_UNAVAILABLE"); }
+    if (iterator->getLength() != static_cast<int32_t>(text.size())) { return EgretURefused(operation, "BIDI_ADAPTER_LENGTH"); }
+    std::vector<SkUnicode::BidiLevel> levels;
+    levels.reserve(text.size());
+    for (size_t i = 0; i < text.size(); ++i) { levels.push_back(iterator->getLevelAt(static_cast<int32_t>(i))); }
+    std::vector<int32_t> order(levels.size());
+    unicode->reorderVisual(levels.data(), static_cast<int>(levels.size()), order.data());
+    std::vector<SkUnicode::BidiRegion> regions;
+    if (!unicode->getBidiRegions(utf8.c_str(), static_cast<int>(utf8.size()),
+            direction == 0 ? SkUnicode::TextDirection::kLTR : SkUnicode::TextDirection::kRTL, &regions)) {
+        return EgretURefused(operation, "BIDI_REGIONS_REFUSED");
+    }
+    if (regions.size() > text.size() + 1) { return EgretURefused(operation, "BIDI_REGIONS_BOUND"); }
+    auto copied = val::array();
+    for (const auto& region : regions) {
+        if (region.start > region.end || region.end > utf8.size()) { return EgretURefused(operation, "BIDI_REGION_RANGE"); }
+        auto record = val::object();
+        record.set("start", region.start);
+        record.set("end", region.end);
+        record.set("level", static_cast<uint32_t>(region.level));
+        copied.call<void>("push", record);
+    }
+    auto out = EgretUObservedText(operation, text, utf8);
+    out.set("inputKind", std::string("characters"));
+    out.set("direction", static_cast<int32_t>(direction));
+    out.set("levels", EgretUNumbers(levels));
+    out.set("visualToLogical", EgretUNumbers(order));
+    out.set("offsetDomain", std::string("utf16-code-units"));
+    out.set("regions", copied);
+    out.set("regionOffsetDomain", std::string("utf8-bytes"));
+    out.set("permutationInputDomain", std::string("UTF16 level slots, not final paragraph visual runs"));
+    return out;
+}
+}  // namespace
