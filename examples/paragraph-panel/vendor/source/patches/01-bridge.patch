+JSObject GetEgretQualificationSnapshot(para::Paragraph& self) {
+    auto& paragraph = static_cast<para::ParagraphImpl&>(self);
+    std::array<bool, 16> previouslyPopulated{};
+    if (paragraph.lines().size() <= previouslyPopulated.size()) {
+        for (size_t i = 0; i < paragraph.lines().size(); ++i) {
+            previouslyPopulated[i] = paragraph.lines()[i].egretQualificationCachePopulated();
+        }
+    }
+    if (!paragraph.egretQualificationPrepare()) { return EgretQStatus(paragraph, "REFUSED"); }
+
+    std::array<EgretQRunRef, 256> refs{};
+    size_t runCount = 0;
+    for (size_t i = 0; i < paragraph.runs().size(); ++i) {
+        refs[runCount++] = {&paragraph.runs()[i], static_cast<int>(i), -1, "source"};
+    }
+    for (size_t i = 0; i < paragraph.lines().size(); ++i) {
+        auto& line = paragraph.lines()[i];
+        if (line.ellipsis()) {
+            refs[runCount++] = {line.ellipsis(), -1, static_cast<int>(i), "ellipsis"};
+        }
+        if (line.hyphen()) {
+            refs[runCount++] = {line.hyphen(), -1, static_cast<int>(i), "visible-hyphen"};
+        }
+    }
+    // Validate all dynamic counts/identities before allocating copied JS data or
+    // temporary typeface wrappers. No partial/truncated snapshot is returned.
+    const char* failure = nullptr;
+    size_t drawGlyphs = 0, drawRecords = 0, contextRecords = 0;
+    for (size_t i = 0; i < runCount; ++i) {
+        if (refs[i].run->egretQualificationLanguage().size() > 1024) {
+            failure = "language-copy-bound";
+        }
+    }
+    for (auto& line : paragraph.lines()) {
+        line.iterateThroughVisualRuns(false,
+            [&](const para::Run* run, SkScalar offset, para::TextRange text, SkScalar* width) {
+                const int id = EgretQRunIndex(refs, runCount, run);
+                if (id < 0) { failure = "visual-run-identity"; *width = 0; return false; }
+                *width = line.iterateThroughSingleRunByStyles(para::TextLine::GlyphCluster,
+                    run, offset, text, para::StyleType::kNone,
+                    [&](para::TextRange, const para::TextStyle&, const para::TextLine::ClipContext& c) {
+                        if (++contextRecords > 1024 || c.pos > run->size() ||
+                            c.size > run->size() - c.pos) { failure = "visual-context-copy-bound"; }
+                    });
+                return failure == nullptr;
+            });
+        for (const auto& rec : line.fTextBlobCache) {
+            if (++drawRecords > 1024) { failure = "blob-record-copy-bound"; break; }
+            const int id = EgretQRunIndex(refs, runCount, rec.fVisitor_Run);
+            if (id < 0) { failure = "blob-run-identity"; break; }
+            if (!rec.fBlob) { continue; }
+            size_t pos = rec.fVisitor_Pos;
+            SkTextBlob::Iter iterator(*rec.fBlob);
+            SkTextBlob::Iter::ExperimentalRun blobRun;
+            while (iterator.experimentalNext(&blobRun)) {
+                if (blobRun.count < 0 || static_cast<size_t>(blobRun.count) > 1024 ||
+                    drawGlyphs > 1024 - static_cast<size_t>(blobRun.count) ||
+                    pos > refs[id].run->size() ||
+                    static_cast<size_t>(blobRun.count) > refs[id].run->size() - pos ||
+                    !(blobRun.font == refs[id].run->font()) ||
+                    (blobRun.count && (!blobRun.glyphs || !blobRun.positions))) {
