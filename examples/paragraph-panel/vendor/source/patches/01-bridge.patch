+    auto result = EgretQStatus(paragraph, "OBSERVED");
+    result.set("schema", std::string("private-egret-native-paragraph-observation/1"));
+    result.set("sourceUtf8", MakeTypedArray(static_cast<int>(paragraph.text().size()),
+        reinterpret_cast<const uint8_t*>(paragraph.text().data())));
+    result.set("scope", std::string("raw native structure and current foreground draw occurrences; no semantic acceptance"));
+    result.set("nativeGraphemeFlagsAreOriginalUnicode", false);
+    result.set("sourceRunCount", paragraph.runs().size());
+    result.set("drawGlyphOccurrences", drawGlyphs);
+    result.set("drawRecordCount", drawRecords);
+    auto runs = val::array();
+    for (size_t i = 0; i < runCount; ++i) {
+        const auto& ref = refs[i];
+        const auto& run = *ref.run;
+        auto out = val::object();
+        out.set("id", i);
+        out.set("role", std::string(ref.role));
+        out.set("sourceArrayIndex", ref.sourceIndex < 0 ? val::null() : val(ref.sourceIndex));
+        out.set("syntheticLineIndex", ref.lineIndex < 0 ? val::null() : val(ref.lineIndex));
+        out.set("nativeIndex", run.index());
+        out.set("nativeTextRange", EgretQRange(run.textRange()));
+        out.set("textRangeDomain", std::string(ref.sourceIndex < 0 ? "synthetic-local-utf8" : "original-utf8"));
+        out.set("nativeClusterRange", EgretQRange(run.clusterRange()));
+        out.set("clusterRangeIsSourceTable", ref.sourceIndex >= 0);
+        out.set(ref.sourceIndex < 0 ? "nativeAttachmentByteOffset" : "sourceStartByteOffset",
+                run.egretQualificationClusterStart());
+        out.set("localUtf8Range", EgretQRange(run.egretQualificationLocalUtf8Range()));
+        out.set("bidiLevel", run.egretQualificationBidiLevel());
+        out.set("leftToRight", run.leftToRight());
+        out.set("scriptTag", run.egretQualificationScript());
+        out.set("language", std::string(run.egretQualificationLanguage().c_str(),
+                                         run.egretQualificationLanguage().size()));
+        out.set("nativeOffset", EgretQPoint(run.offset()));
+        out.set("rawAdvance", EgretQPoint(run.egretQualificationRawAdvance()));
+        out.set("metricsAdvance", EgretQPoint(run.advance()));
+        out.set("baselineShift", run.baselineShift());
+        out.set("heightMultiplier", run.heightMultiplier());
+        out.set("useHalfLeading", run.useHalfLeading());
+        out.set("font", EgretQFont(run.font()));
+        out.set("glyphs", MakeTypedArray(static_cast<int>(run.glyphs().size()), run.glyphs().data()));
+        out.set("positions", MakeTypedArray(static_cast<int>(run.positions().size() * 2),
+            reinterpret_cast<const float*>(run.positions().data())));
+        out.set("offsets", MakeTypedArray(static_cast<int>(run.offsets().size() * 2),
+            reinterpret_cast<const float*>(run.offsets().data())));
+        out.set("localClusterIndexes", MakeTypedArray(static_cast<int>(run.clusterIndexes().size()),
+            run.clusterIndexes().data()));
+        const auto shifts = run.egretQualificationJustification();
+        out.set("justificationShifts", MakeTypedArray(static_cast<int>(shifts.size() * 2),
+            reinterpret_cast<const float*>(shifts.data())));
+        out.set("terminalSlot", run.size());
+        out.set("terminalClusterConvention", std::string(run.leftToRight()
+            ? "local-utf8-range-end" : "local-utf8-range-begin"));
+        out.set("syntheticPaintRuleQualified", false);
+        runs.call<void>("push", out);
+    }
+    result.set("runs", runs);
+
+    auto clusters = val::array();
+    for (size_t i = 0; i < paragraph.clusters().size(); ++i) {
+        const auto& cluster = paragraph.clusters()[i];
+        auto out = val::object();
+        out.set("id", i);
+        out.set("textRange", EgretQRange(cluster.textRange()));
+        const bool terminal = cluster.runIndex() == para::EMPTY_RUN;
+        out.set("terminalNonRunSentinel", terminal);
+        out.set("nativeRunIndex", cluster.runIndex());
+        out.set("runId", terminal ? val::null() : val(cluster.runIndex()));
+        if (!terminal) {
+            out.set("glyphStart", cluster.startPos());
+            out.set("glyphEnd", cluster.endPos());
+            out.set("width", cluster.width());
+            out.set("height", cluster.height());
+            out.set("halfLetterSpacing", cluster.getHalfLetterSpacing());
+        }
+        // No per-cluster break flags, especially no sentinel's uninitialized flags.
+        clusters.call<void>("push", out);
+    }
+    result.set("clusters", clusters);
+
+    auto lines = val::array();
+    for (size_t i = 0; i < paragraph.lines().size(); ++i) {
+        auto& line = paragraph.lines()[i];
+        auto out = val::object();
+        out.set("id", i);
+        out.set("textRange", EgretQRange(line.text()));
+        out.set("trimmedTextRange", EgretQRange(line.trimmedText()));
+        out.set("textWithNewlinesRange", EgretQRange(line.textWithNewlines()));
+        out.set("clusterRange", EgretQRange(line.clusters()));
+        out.set("ghostClusterRange", EgretQRange(line.clustersWithSpaces()));
+        out.set("offset", EgretQPoint(line.offset()));
+        out.set("height", line.height());
+        out.set("width", line.width());
+        out.set("sourceAdvanceWidth", line.widthWithoutEllipsis());
+        out.set("spacesWidth", line.spacesWidth());
+        out.set("alphabeticBaseline", line.alphabeticBaseline());
+        out.set("ideographicBaseline", line.ideographicBaseline());
+        out.set("baseline", line.baseline());
+        const auto sizes = line.sizes();
+        out.set("ascent", sizes.ascent());
+        out.set("descent", sizes.descent());
+        out.set("leading", sizes.leading());
+        out.set("rawAscent", sizes.rawAscent());
+        out.set("rawDescent", sizes.rawDescent());
+        out.set("cacheWasPopulated", previouslyPopulated[i]);
+        out.set("cacheIsPopulated", line.egretQualificationCachePopulated());
+        auto visits = val::array();
+        line.iterateThroughVisualRuns(false,
+            [&](const para::Run* run, SkScalar offset, para::TextRange text, SkScalar* width) {
+                const int id = EgretQRunIndex(refs, runCount, run);
+                auto visit = val::object();
+                visit.set("runId", id);
+                visit.set("runOffset", offset);
+                visit.set("nativeVisualTextRange", EgretQRange(text));
+                auto contexts = val::array();
+                *width = line.iterateThroughSingleRunByStyles(para::TextLine::GlyphCluster,
+                    run, offset, text, para::StyleType::kNone,
+                    [&](para::TextRange nativeText, const para::TextStyle&,
+                        const para::TextLine::ClipContext& context) {
+                        auto copied = EgretQContext(context, id);
+                        copied.set("nativeCallbackTextRange", EgretQRange(nativeText));
+                        copied.set("callbackRangeDomain", std::string(refs[id].sourceIndex < 0
+                            ? "upstream-synthetic-style-test-range-not-source" : "original-utf8"));
+                        contexts.call<void>("push", copied);
+                    });
+                visit.set("nativeWidthReturned", *width);
+                visit.set("contexts", contexts);
+                visits.call<void>("push", visit);
+                return true;
+            });
+        out.set("visualVisits", visits);
+        auto records = val::array();
+        for (const auto& rec : line.fTextBlobCache) {
+            auto record = val::object();
+            const int id = EgretQRunIndex(refs, runCount, rec.fVisitor_Run);
+            record.set("runId", id);
+            record.set("glyphStart", rec.fVisitor_Pos);
+            record.set("drawOrigin", EgretQPoint(rec.fOffset));
+            record.set("clip", EgretQRect(rec.fClipRect));
+            record.set("clippingNeeded", rec.fClippingNeeded);
+            record.set("bounds", EgretQRect(rec.fBounds));
+            record.set("foreground", EgretQPaint(rec.fPaint));
+            record.set("hasBlob", rec.fBlob != nullptr);
+            auto blobRuns = val::array();
+            size_t count = 0;
+            if (rec.fBlob) {
+                SkTextBlob::Iter iterator(*rec.fBlob);
+                SkTextBlob::Iter::ExperimentalRun blobRun;
+                while (iterator.experimentalNext(&blobRun)) {
+                    auto draw = val::object();
+                    draw.set("glyphStart", rec.fVisitor_Pos + count);
+                    draw.set("glyphCount", blobRun.count);
+                    draw.set("font", EgretQFont(blobRun.font));
+                    draw.set("typefaceIdentityFromRunId", id);
+                    draw.set("glyphs", MakeTypedArray(blobRun.count, blobRun.glyphs));
+                    draw.set("positions", MakeTypedArray(blobRun.count * 2,
+                        reinterpret_cast<const float*>(blobRun.positions)));
+                    blobRuns.call<void>("push", draw);
+                    count += blobRun.count;
+                }
+            }
+            record.set("glyphCount", count);
+            record.set("blobRuns", blobRuns);
+            records.call<void>("push", record);
+        }
+        out.set("drawRecords", records);
+        lines.call<void>("push", out);
+    }
+    result.set("lines", lines);
+    // Exactly one owned temporary wrapper per non-null run face. The collector
+    // must resolve against its owned known faces and delete each wrapper before
+    // serialization; arrays/objects above are copies, not Wasm views. Fatal OOM
+    // while creating wrappers invalidates the generation, not a cleanup success.
+    size_t wrappers = 0;
+    for (size_t i = 0; i < runCount; ++i) {
+        const auto face = refs[i].run->font().refTypeface();
+        runs[i]["font"].set("typeface", face ? val(face) : val::null());
+        if (face) { ++wrappers; }
+    }
+    result.set("ownedTemporaryTypefaceWrappers", wrappers);
+    return result;
+}
