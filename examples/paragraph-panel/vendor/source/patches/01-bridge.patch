+    paragraph.egretQualificationSetClusterPaint(enabled);
+    auto result = EgretQStatus(paragraph,
+        paragraph.egretQualificationPrepare() ? "MODE_READY" : "REFUSED");
+    result.set("modeChanged", changed);
+    result.set("sameModeKeepsExistingCache", !changed);
+    return result;
+}
