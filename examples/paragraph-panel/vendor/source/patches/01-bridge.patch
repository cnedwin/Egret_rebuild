+JSObject EgretQRange(para::TextRange range) {
+    auto out = val::object();
+    out.set("start", range.start);
+    out.set("end", range.end);
+    return out;
+}
+
+JSArray EgretQPoint(SkPoint point) {
+    auto out = val::array();
+    out.call<void>("push", point.x());
+    out.call<void>("push", point.y());
+    return out;
+}
+
+JSArray EgretQRect(SkRect rect) {
+    auto out = val::array();
+    out.call<void>("push", rect.left());
+    out.call<void>("push", rect.top());
+    out.call<void>("push", rect.right());
+    out.call<void>("push", rect.bottom());
+    return out;
+}
+
+JSObject EgretQFont(const SkFont& font) {
+    auto out = val::object();
+    out.set("size", font.getSize());
+    out.set("scaleX", font.getScaleX());
+    out.set("skewX", font.getSkewX());
+    out.set("edging", static_cast<int>(font.getEdging()));
+    out.set("hinting", static_cast<int>(font.getHinting()));
+    out.set("forceAutoHinting", font.isForceAutoHinting());
+    out.set("embeddedBitmaps", font.isEmbeddedBitmaps());
+    out.set("subpixel", font.isSubpixel());
+    out.set("linearMetrics", font.isLinearMetrics());
+    out.set("embolden", font.isEmbolden());
+    out.set("baselineSnap", font.isBaselineSnap());
+    // Owned temporary typeface wrappers are attached only after all copied data.
+    return out;
+}
+
+JSObject EgretQPaint(const para::ParagraphPainter::SkPaintOrID& paint) {
+    auto out = val::object();
+    if (std::holds_alternative<para::ParagraphPainter::PaintID>(paint)) {
+        out.set("kind", std::string("native-paint-id"));
+        out.set("value", std::get<para::ParagraphPainter::PaintID>(paint));
+        return out;
+    }
+    const auto& p = std::get<SkPaint>(paint);
+    out.set("kind", std::string("SkPaint"));
+    const auto rgba = p.getColor4f();
+    const float values[] = {rgba.fR, rgba.fG, rgba.fB, rgba.fA};
+    out.set("rgba", MakeTypedArray(4, values));
+    out.set("antiAlias", p.isAntiAlias());
+    out.set("dither", p.isDither());
+    out.set("style", static_cast<int>(p.getStyle()));
+    out.set("strokeWidth", p.getStrokeWidth());
+    out.set("strokeMiter", p.getStrokeMiter());
+    out.set("strokeCap", static_cast<int>(p.getStrokeCap()));
+    out.set("strokeJoin", static_cast<int>(p.getStrokeJoin()));
+    const auto blend = p.asBlendMode();
+    out.set("blendMode", blend ? val(static_cast<int>(*blend)) : val::null());
+    out.set("hasShader", p.getShader() != nullptr);
+    out.set("hasColorFilter", p.getColorFilter() != nullptr);
+    out.set("hasPathEffect", p.getPathEffect() != nullptr);
+    out.set("hasMaskFilter", p.getMaskFilter() != nullptr);
+    out.set("hasImageFilter", p.getImageFilter() != nullptr);
