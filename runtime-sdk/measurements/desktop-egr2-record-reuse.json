  "sources": {
    "file": "runtime-sdk/scene/project-frame.mjs",
    "hashDefinition": "Lowercase SHA-256 of the complete encoder module file bytes used by that lane. These identify JavaScript sources, not commits, packages or command packets.",
    "baseline": {
      "sha256": "00950692be75b7efc5ca57dd3d5d324275de92ada230dc700f443aca529e84bf",
      "entry": "encodeProjectFrame(frame, frameId, pageIds): stateless historical encoder from the #386 source checkout"
    },
    "candidate": {
      "sha256": "0c0c85ba4d6c697ff4707d14931a568b0f1f84b0d78a03e52a30635d58fe0112",
      "entry": "One createCapturedProjectEncoder() per process; each timed invocation calls its encode(frame, frameId, pageIds) method with immutable draw commands."
    }
  },
  "protocol": {
    "scope": "Synthetic Windows desktop CPU encoding of already-built captured-frame objects. The timer surrounds only one encoder call. Android scheduling, shared-frame capture, Javet, GPU, presentation and power are outside this comparison.",
    "unit": "microseconds",
    "clock": "Node performance.now(), elapsed milliseconds multiplied by 1000. Per-process p50 and p95 values retain their original numeric representation.",
    "processes": "72 fresh sequential processes; 12 paired baseline/candidate runs for each of three loads. Odd-numbered pairs run baseline first and even-numbered pairs run candidate first. The starting load rotates between pairs.",
    "frames": "Before timing, each process builds 210 synthetic frame inputs. It encodes frame IDs 0 through 209 in a tight loop. IDs 0 through 29 warm up that process. IDs 30 through 209 provide the 180 timed samples.",
    "aggregation": "Per process, p50 is the arithmetic mean of the two middle observations, and p95 is nearest rank. Across 12 runs in a lane, take the average of its two middle values. Positive paired reduction is faster. Percent change uses the matching baseline p95 as its denominator.",
    "identity": "Each fresh process encodes every frame and retains its returned packet until after timing. SHA-256 covers all 210 concatenated packets, including headers and warmup frames. All baseline and candidate process digests matched within each load.",
    "evidenceBoundary": "The original desktop receipts retained per-process p50, p95 and packet hashes. The underlying individual frame timings were not persisted. External CPU load, thread affinity and clock frequencies were not controlled. No mobile performance threshold was applied here."
  },
  "commonFixture": {
    "viewport": [
      360,
      640
    ],
    "quadCount": 81,
    "drawOrder": "Even indices draw images (41), odd indices draw rectangles (40).",
    "geometry": "Each quad has rectangle [0,0,32,32], identity linear transform, x translation equal to its zero-based index and y translation 32. Every fourth quad has no clip; remaining quads use one shared 32×32 clip translated by [14,32].",
    "materials": "One supported nearest-filtered material; two texture slots, 8 and 9, with 64×64 and 128×80 source pages. Each image uses one of two small atlas regions.",
    "control": "Geometry, clip, material, opacity, resident pages, atlas coordinates, and draw order are otherwise identical across the three loads. Each modified command is a fresh frozen object with a fresh matrix; only its x translation changes."
  },
