  "findings": [
    {
      "id": "R1",
      "tests": [
        "R1 Scope blocks same-value ownership reentry before binding commit",
        "R1 Scope closing during callback preflight rejects and cleans its late value"
      ],
      "implementation": [
        "packages/runtime/src/Scope.ts",
        "packages/runtime/src/ownership.ts",
        "packages/runtime/src/displayTreeState.ts"
      ],
      "correction": "Global same-value registration guard; recheck root owner, Scope and Engine acceptance after callback-capable preflight; traverse current actual tree with callback-free Engine-binding/terminal-state checks before committing.",
      "boundary": "Scope owner uniqueness, Engine binding and safe unowned late-value cleanup",
      "disposition": "fixed_with_red_green",
      "red": "work/core-framework/fix-1-red-clean.log",
      "green": "work/core-framework/fix-1-green-regressions.log",
      "fullPipeline": "work/core-framework/fix-1-verify.log"
    },
    {
      "id": "R2",
      "tests": [
        "R2 atomic reparenting uses internal detach without old-parent override callbacks"
      ],
      "implementation": [
        "packages/runtime/src/displayTreeState.ts",
        "packages/runtime/src/DisplayObject.ts",
        "packages/runtime/src/DisplayObjectContainer.ts",
        "packages/runtime/src/Stage.ts",
        "packages/runtime/src/ownership.ts"
      ],
      "correction": "Central internal parent/children/terminal/Stage-root authority; callback-free final tree checks and non-virtual detach/attach. Internal operations do not invoke old-parent removeChild override.",
      "boundary": "Atomic mount, no reparent into terminal Stage, and no implicit mount/remove notification contract",
      "ruling": "Old reviewer repro expected rejection after an override-triggered close. Selected non-virtual commit prevents that callback, so regression expects successful mount into a live Stage, then ordinary full shutdown. Parent explicitly accepted this permitted correction.",
      "disposition": "fixed_with_red_green",
      "red": "work/core-framework/fix-1-red-clean.log",
      "green": "work/core-framework/fix-1-green-regressions.log",
      "fullPipeline": "work/core-framework/fix-1-verify.log"
    },
    {
      "id": "R3",
      "tests": [
        "R3 open older Scope still cleans an unowned late value while Engine is closing"
      ],
      "implementation": [
        "packages/runtime/src/Scope.ts"
      ],
      "correction": "Engine closing is a rejection boundary even when the receiving Scope remains open; retain existing safe late-value cleanup/queued-old-value/foreign ownership rules and reject with ENGINE_CLOSED.",
      "boundary": "Already acquired unowned late resources cannot leak during reverse Scope shutdown",
      "disposition": "fixed_with_red_green",
      "red": "work/core-framework/fix-1-red-clean.log",
      "green": "work/core-framework/fix-1-green-regressions.log",
      "fullPipeline": "work/core-framework/fix-1-verify.log"
    },
    {
      "id": "R4",
      "tests": [
        "R4 failed signal registration rolls back unreachable handler and retains adapter errors",
        "R4 failed post-registration cancellation check also rolls back the local handler"
      ],
      "implementation": [
        "packages/runtime/src/EventDispatcher.ts"
      ],
      "correction": "Try registration and post-registration checks together. On failure deactivate and remove local subscription first, then separately attempt adapter rollback; throw EVENT_SUBSCRIPTION_FAILED with original cause and rollback cleanupErrors.",
      "boundary": "Failed on call leaves no live unreachable handler; add/check/rollback errors retain provenance",
      "disposition": "fixed_with_red_green",
      "red": "work/core-framework/fix-1-red-clean.log",
      "green": "work/core-framework/fix-1-green-regressions.log",
      "fullPipeline": "work/core-framework/fix-1-verify.log"
    },
    {
      "id": "R5",
      "tests": [
        "R5 all listener failures and children finish before host close with aggregated causes",
        "R5 listener failure still reaches bounded host close and retains ownership until success"
      ],
      "implementation": [
        "packages/runtime/src/EventDispatcher.ts",
        "packages/runtime/src/DisplayObject.ts",
        "packages/runtime/src/DisplayObjectContainer.ts",
        "packages/engine/src/Engine.ts"
      ],
      "correction": "Isolate each unsubscribe error, deactivate local subscriptions before adapter removal, continue listeners and child cleanup; isolate each Engine Scope/Stage cleanup failure and still stop then bounded-close host; aggregate original failures into EgretError cause/cleanupErrors.",
      "boundary": "Failure cannot skip siblings/subtree or host stop/close; successful close alone releases surface, including late success after deadline",
      "disposition": "fixed_with_red_green",
      "red": "work/core-framework/fix-1-red-clean.log",
      "green": "work/core-framework/fix-1-green-regressions.log",
      "fullPipeline": "work/core-framework/fix-1-verify.log"
    }
  ],
