  "findings": [
    {
      "id": "AR1",
      "severity": "P2",
      "status": "open",
      "title": "Callback invocation reads mutable function.call after registration",
      "file": "packages/runtime/src/AssetManager.ts",
      "relevantCode": [
        "load.call(provider, ref as unknown as AssetRef<T>, context)",
        "dispose.call(provider, value as T)"
      ],
      "contract": "register fixes provider callbacks at registration time.",
      "reproduction": "callback-capture-counterexample.mjs: register ordinary load/dispose functions; define their own call properties after registration while preserving function identity; acquire and release through @egret/engine.",
      "actual": {
        "value": 2,
        "trace": [
          "replacement-call-load",
          "replacement-call-dispose"
        ]
      },
      "expected": {
        "value": 1,
        "trace": [
          "registered-load",
          "registered-dispose:1"
        ]
      },
      "effect": "The registered loader and disposer are never invoked, so postregistration mutation can silently replace resource behavior and skip cleanup.",
      "rationale": "This changes only user-owned properties on registered callback objects and does not patch global intrinsics.",
      "recommendation": "Invoke captured callables through an intrinsic invocation operation and preserve provider receiver binding. Add a narrow regression for loader/disposer own call property mutation."
    }
  ],
